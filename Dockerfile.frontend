FROM node:18-alpine as build

WORKDIR /app

# 复制 frontend 的 package.json
COPY frontend/package*.json ./

# 安装依赖
RUN npm install

# 复制前端代码
COPY frontend/ ./

# 构建前端
RUN npm run build

# 使用 nginx 作为生产服务器
FROM nginx:alpine

# 复制构建好的文件到 nginx
COPY --from=build /app/dist /usr/share/nginx/html

# 复制 nginx 配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

