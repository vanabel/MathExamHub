{
  "macros": {
    "fillin": ["\\underline{\\phantom{|}#1\\phantom{|}}", 1],
    "fillout": ["\\underline{\\phantom{|}#1\\phantom{|}}", 1],
    "pickout": ["\\text{(#1)}", 1],
    "score": ["\\qquad\\text{(#1分)}", 1],
    "true": "\\checkmark",
    "false": "\\text{\\sffamily x}",
    "bu": "\\mathbf{u}",
    "bv": "\\mathbf{v}",
    "bw": "\\mathbf{w}",
    "bo": "\\mathbf{0}",
    "be": "\\mathbf{e}",
    "br": "\\mathbf{r}",
    "bt": "\\mathbf{t}",
    "bn": "\\mathbf{n}",
    "bb": "\\mathbf{b}",
    "I": "\\mathrm{I}",
    "II": "\\mathrm{I\\!I}",
    "emph": ["\\textit{#1}", 1]
  }
}
