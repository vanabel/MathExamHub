# LLM API 配置 (Choose one provider)

# Provider: openai, siliconflow, or ollama
LLM_API_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# SiliconFlow Configuration
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Ollama Configuration (本地部署)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Database Configuration (可选，如果不使用默认的 mongodb://localhost:27017/mathexam)
# MONGODB_URI=mongodb://localhost:27017/mathexam
