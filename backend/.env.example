# 后端环境变量示例（复制为 backend/.env）
PORT=3000
MONGODB_URI=mongodb://localhost:27017/mathexam
SESSION_SECRET=change_me_in_production

# 浏览器跨域来源（逗号分隔）。默认含 https://exam.vanabel.cn 与 localhost/127.0.0.1:8080、3000
# NAS PM2 生产示例：PORT=19897，CORS_ORIGINS=https://exam.vanabel.cn
# CORS_ORIGINS=https://exam.vanabel.cn,http://localhost:8080

# 可选：/api/health 返回的 git commit（部署脚本可 export GIT_COMMIT=$(git rev-parse --short HEAD)）
# GIT_COMMIT=

# OpenAI（可选，用于 /api/questions/extractKeywords）
OPENAI_API_KEY=
