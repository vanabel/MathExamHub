# Docker 环境变量配置
# 复制此文件为 .env 并修改为你的实际配置
# 注意：MongoDB URI 在 Docker 环境中应使用服务名 "mongodb" 作为主机名

# MongoDB 数据库连接（Docker 环境）
# Docker 网络内使用服务名: mongodb://mongodb:27017/mathexam
# 如果需要连接外部 MongoDB（有认证）: mongodb://用户名:密码@host.docker.internal:27017/mathexam?authSource=admin
MONGODB_URI=mongodb://mongodb:27017/mathexam

# 后端服务端口
PORT=3000

# Session 密钥（用于加密 session，请使用随机字符串）
# 生成方式: openssl rand -hex 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_change_me

# LLM API 配置
# 可选值: openai, siliconflow, ollama
LLM_API_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here

# SiliconFlow 配置（可选）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Ollama 配置（可选，本地部署）
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
